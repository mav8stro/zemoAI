{
  "name": "zemo",
  "private": true,
  "version": "0.0.0",
  "description": "A browser voice assistant with a clean ZEMO chat interface, driven by Claude Code through a small Node bridge.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src bridge electron scripts",
    "preview": "vite preview",
    "bridge": "node bridge/server.mjs",
    "bridge:writes": "node scripts/bridge-writes.mjs",
    "start:heal": "node scripts/self-heal-supervisor.mjs",
    "setup": "node scripts/setup.mjs",
    "onboard": "node scripts/onboard.mjs",
    "install-service": "node scripts/install-service.mjs",
    "list-voices": "node scripts/list-voices.mjs",
    "app": "node windows/launcher.mjs",
    "windows": "node windows/launcher.mjs",
    "electron": "electron .",
    "electron:dev": "node scripts/electron-dev.mjs",
    "build:exe": "npm run build && electron-builder --win",
    "build:apk": "npm run build && node scripts/build-apk.mjs",
    "mobile": "node windows/launcher.mjs",
    "build:app": "npm run build && electron-builder --mac dmg",
    "build:appimage": "npm run build && electron-builder --linux AppImage"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.zemo.assistant",
    "productName": "ZEMO",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "bridge/**/*",
      "skills/**/*",
      "scripts/**/*",
      ".env.local",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZEMO",
      "menuCategory": "ZEMO"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@anthropic-ai/sdk": "^0.115.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@picovoice/porcupine-web": "^4.0.1",
    "@picovoice/web-voice-processor": "^4.0.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "border-beam": "^1.4.1",
    "bot-avatars": "^0.2.1",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.43.0",
    "kokoro-js": "^1.2.1",
    "liquid-gooey": "^0.2.2",
    "metal-fx": "^2.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "thinking-orbs": "^0.3.2",
    "three": "^0.185.1",
    "voice-glow": "^0.2.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
